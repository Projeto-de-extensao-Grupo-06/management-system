# ==============================================================================
# Solarway Management System — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e preencha os valores conforme o ambiente.
# Nunca comite o arquivo .env com valores reais.
# ==============================================================================


# ------------------------------------------------------------------------------
# VITE_BACKEND_URL
# Usado em: vite.config.ts (proxy do Vite no servidor de desenvolvimento)
# Escopo: APENAS dev local — o Vite faz proxy de /api/* para esse target.
#         Em produção essa variável é IGNORADA; quem faz o proxy é o Nginx
#         via BACKEND_URL (ver abaixo).
# Padrão: http://localhost:8080
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8080


# ------------------------------------------------------------------------------
# VITE_API_BASE_URL
# Usado em: src/services/provider/api.ts (baseURL do Axios)
# Escopo: Build-time — o Vite substitui o valor diretamente no bundle JS.
#
# ⚠️  NÃO defina esta variável em produção.
#     Em produção o Axios deve usar o fallback '/api' (caminho relativo),
#     permitindo que o Nginx interno do container faça o proxy para o backend.
#     Se você definir uma URL absoluta aqui, o browser tentará acessá-la
#     diretamente, bypassando o proxy Nginx e causando erros de CORS.
#
# Padrão (omitir = usar fallback '/api')
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=


# ------------------------------------------------------------------------------
# BACKEND_URL
# Usado em: nginx.conf.template + docker-compose.yml
# Escopo: Runtime do container Nginx — substituído pelo envsubst do Nginx no
#         startup do container. Aponta para o serviço de backend acessível
#         dentro da rede Docker.
# Padrão (docker-compose local com mock API): http://api:3000
# Produção (EC2 / Terraform): URL interna do backend real (ex: http://api:8080)
# ------------------------------------------------------------------------------
BACKEND_URL=http://api:3000
